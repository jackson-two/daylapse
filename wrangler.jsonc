{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daylapse-oss",
  "account_id": "00000000000000000000000000000000",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": []
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daylapse-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "DAYLAPSE": {
      "familyHostname": "localhost",
      "displayHostname": "",
      "accessTeamDomain": "",
      "accessAudience": "",
      "timeZone": "UTC",
      "notifications": false,
      "localDevelopment": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
