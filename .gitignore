# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.pnpm-store/
*.tsbuildinfo
/outputs/
/work/

# Private exports, database state, credentials, and local tooling
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.key
*.p12
*.pfx
*.log
/backups/
/exports/
/.codex/
/.agents/

# Per-installation settings and generated deployment configuration
/installation.json
/wrangler.deploy.jsonc
