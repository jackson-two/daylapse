{
  "name": "daylapse",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "npm run setup -- deploy",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && node --import tsx --test tests/*.test.ts && node --test tests/d1-revisions.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "notifications:keys": "node scripts/generate-vapid.mjs",
    "rows": "node --import tsx scripts/row-storage.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "deploy:check": "npm run setup -- deploy-check",
    "smoke": "node --import tsx scripts/smoke.ts",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "miniflare": "5.20260921.0-alpha",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.137.0"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  },
  "pnpm": {
    "overrides": {
      "vinext>image-size": "2.0.4"
    }
  }
}
